<Window x:Class="WiiFitLab.SnowboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wii Fit Lab — サイドスタンス・スノーボード"
        Width="1180" Height="790" MinWidth="1100" MinHeight="730"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="820" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="16" ClipToBounds="True" BorderBrush="#86D9F3" BorderThickness="2">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#07182D" Offset="0" />
                        <GradientStop Color="#286B91" Offset="0.42" />
                        <GradientStop Color="#EAF8FF" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Canvas x:Name="CourseCanvas" Width="820" Height="700" ClipToBounds="True">
                    <Ellipse Width="130" Height="130" Fill="#FFF4C2" Opacity="0.92" Canvas.Left="610" Canvas.Top="50" />
                    <Polygon Points="0,260 135,115 270,270" Fill="#173650" />
                    <Polygon Points="95,160 135,115 172,165 143,153 125,177" Fill="#DDF5FF" />
                    <Polygon Points="155,280 350,75 535,285" Fill="#1C4564" />
                    <Polygon Points="280,148 350,75 414,145 372,129 340,164 318,137" Fill="#F3FBFF" />
                    <Polygon Points="450,285 635,110 820,285" Fill="#153B59" />
                    <Polygon Points="574,168 635,110 692,168 655,153 627,179 605,151" Fill="#EAF8FF" />

                    <Polygon Points="310,135 510,135 760,700 60,700" Fill="#EAF8FC" />
                    <Polygon Points="310,135 350,135 220,700 60,700" Fill="#D2EBF5" Opacity="0.75" />
                    <Polygon Points="470,135 510,135 760,700 600,700" Fill="#BFDDEA" Opacity="0.58" />
                    <Line X1="310" Y1="135" X2="60" Y2="700" Stroke="#89BED0" StrokeThickness="3" />
                    <Line X1="510" Y1="135" X2="760" Y2="700" Stroke="#89BED0" StrokeThickness="3" />
                    <Line X1="375" Y1="135" X2="305" Y2="700" Stroke="#B3D5E0" StrokeThickness="2" StrokeDashArray="7,9" />
                    <Line X1="445" Y1="135" X2="515" Y2="700" Stroke="#B3D5E0" StrokeThickness="2" StrokeDashArray="7,9" />

                    <Canvas x:Name="SnowLayer" IsHitTestVisible="False" />
                    <Canvas x:Name="ObjectLayer" IsHitTestVisible="False" />

                    <Canvas x:Name="PlayerRoot" Width="94" Height="128" Canvas.Left="363" Canvas.Top="535"
                            RenderTransformOrigin="0.5,0.78">
                        <Ellipse Width="72" Height="18" Fill="#8BCADD" Opacity="0.45" Canvas.Left="11" Canvas.Top="106" />
                        <Border Width="92" Height="13" CornerRadius="7" Background="#FF5D72"
                                BorderBrush="White" BorderThickness="2" Canvas.Left="1" Canvas.Top="99" />
                        <Polygon Points="33,27 61,27 70,78 57,100 42,100 25,76"
                                 Fill="#FFB347" Stroke="#FFF1CE" StrokeThickness="2" />
                        <Line X1="36" Y1="70" X2="23" Y2="102" Stroke="#17283A" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="58" Y1="70" X2="70" Y2="101" Stroke="#17283A" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Width="31" Height="31" Fill="#F5C39F" Stroke="#E9FBFF" StrokeThickness="3" Canvas.Left="31" Canvas.Top="3" />
                        <Path Data="M31,19 C37,0 58,0 65,17 L60,11 C51,15 41,14 31,19" Fill="#1E5577" />
                    </Canvas>
                </Canvas>

                <Grid VerticalAlignment="Top" Margin="18,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#D90B1A2C" CornerRadius="14" Padding="13,7" Margin="0,0,8,0">
                            <TextBlock x:Name="SpeedText" Text="0 km/h" FontSize="21" FontWeight="Bold" />
                        </Border>
                        <Border Background="#D90B1A2C" CornerRadius="14" Padding="13,7">
                            <TextBlock x:Name="DistanceText" Text="0 m" FontSize="18" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="#D90B1A2C" CornerRadius="14" Padding="13,7" Margin="0,0,8,0">
                            <TextBlock x:Name="ScoreText" Text="SCORE 0000" FontSize="17" FontWeight="Bold" Foreground="#FFE27A" />
                        </Border>
                        <Border Background="#E34688D8" CornerRadius="14" Padding="13,7">
                            <TextBlock x:Name="TimeText" Text="75" FontSize="21" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border x:Name="AlertBanner" Background="#E6FF5D72" CornerRadius="12" Padding="16,8"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,78,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="AlertText" Text="NICE CARVE!" FontWeight="Bold" />
                </Border>

                <Border x:Name="StartPanel" Width="390" Background="#EC071522" CornerRadius="18" Padding="28,22"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="StartTitle" Text="SIDE STANCE SNOW" Foreground="#8DE8FF"
                                   FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StartMessage" Text="ボードを90°回してニュートラルを記録"
                                   Foreground="#D7EAF3" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                        Background="#C8071522" CornerRadius="12" Padding="14,7">
                    <TextBlock Text="つま先／かかとでカーブ　前足で加速　後ろ足で減速" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="サイドスタンス・スノー" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="横置きしたボードで雪山をカービング" Foreground="{StaticResource MutedBrush}" />

                <Border Background="#17314A" CornerRadius="12" Padding="14" Margin="0,13,0,0">
                    <StackPanel>
                        <TextBlock Text="セット方法" FontWeight="Bold" Foreground="#8DE8FF" />
                        <TextBlock Text="1. ボードをテレビに対して90°回す&#x0a;2. 長い方向へ前足・後ろ足を置く&#x0a;3. 体を画面へ横向きにして自然に立つ"
                                   Foreground="#D6E8F2" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,9,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SignalStatusText" Text="ボード信号待ち" Foreground="#F0A84A" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="旋回" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="TurnText" Text="0 %" FontSize="19" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="前足／後ろ足" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="FootText" Text="中央" FontSize="19" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="CalibrateButton" Content="この姿勢をニュートラルにする" Click="CalibrateButton_Click" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,9,0,0">
                    <StackPanel>
                        <TextBlock Text="スタンス" />
                        <ComboBox x:Name="StanceCombo" SelectedIndex="0" SelectionChanged="StanceCombo_SelectionChanged" Margin="0,4,0,0">
                            <ComboBoxItem Content="レギュラー（左足が前）" />
                            <ComboBoxItem Content="グーフィー（右足が前）" />
                        </ComboBox>
                        <CheckBox x:Name="InvertTurnCheck" Content="つま先／かかとの旋回を反転" Margin="0,9,0,0" />
                        <TextBlock Text="旋回感度" Margin="0,9,0,1" />
                        <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="3" Value="1.7"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="SensitivityText" Text="1.7倍" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,9,0,0">
                    <StackPanel>
                        <Button x:Name="StartButton" Content="ラン開始" Click="StartButton_Click" IsEnabled="False" />
                        <Button Content="コースをリセット" Click="ResetButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,7,0,0" />
                        <TextBlock x:Name="GameStatusText" Text="ニュートラル姿勢を記録してください"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#3A2C1D" CornerRadius="10" Padding="11" Margin="0,9,0,0">
                    <TextBlock Text="安全：ボードの周囲を空け、滑らない床で小さく重心移動してください。ボード上ではジャンプしないでください。"
                               Foreground="#FFD08A" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="予備操作：← → カーブ / ↑ ↓ 加減速&#x0a;Enter 開始・一時停止 / R リセット"
                           Foreground="#8DE8FF" LineHeight="20" Margin="2,9,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
