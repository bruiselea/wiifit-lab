<Window x:Class="WiiFitLab.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wii Fit Lab — 技術モニター"
        Width="1020" Height="760" MinWidth="860" MinHeight="660"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="技術モニター" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="センサー生値・工場校正点・通信速度・直近60秒の波形"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="受信レポート " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ReportRateText" Text="計測中…" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="2" Columns="4">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="左前 TL" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock x:Name="TopLeftRawText" Text="生値 —" FontSize="24" Margin="0,7,0,7" />
                        <TextBlock x:Name="TopLeftCalibrationText" Text="校正点 —" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="右前 TR" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock x:Name="TopRightRawText" Text="生値 —" FontSize="24" Margin="0,7,0,7" />
                        <TextBlock x:Name="TopRightCalibrationText" Text="校正点 —" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="左後 BL" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock x:Name="BottomLeftRawText" Text="生値 —" FontSize="24" Margin="0,7,0,7" />
                        <TextBlock x:Name="BottomLeftCalibrationText" Text="校正点 —" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="右後 BR" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock x:Name="BottomRightRawText" Text="生値 —" FontSize="24" Margin="0,7,0,7" />
                        <TextBlock x:Name="BottomRightCalibrationText" Text="校正点 —" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="正規化ライブ波形" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="左端が約60秒前、右端が現在" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="● 重量 0–150kg" Foreground="#48D7C8" Margin="0,0,16,0" />
                            <TextBlock Text="● 左右 0–100%" Foreground="#55A7FF" Margin="0,0,16,0" />
                            <TextBlock Text="● 前後 0–100%" Foreground="#FFB454" Margin="0,0,16,0" />
                            <TextBlock Text="● 温度 0–50" Foreground="#D889FF" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#101823" BorderBrush="#29394C" BorderThickness="1" CornerRadius="8">
                        <Canvas x:Name="GraphCanvas" Height="310" ClipToBounds="True">
                            <Line X1="0" Y1="77.5" X2="940" Y2="77.5" Stroke="#233245" StrokeThickness="1" />
                            <Line X1="0" Y1="155" X2="940" Y2="155" Stroke="#233245" StrokeThickness="1" />
                            <Line X1="0" Y1="232.5" X2="940" Y2="232.5" Stroke="#233245" StrokeThickness="1" />
                            <Polyline x:Name="WeightLine" Stroke="#48D7C8" StrokeThickness="2" />
                            <Polyline x:Name="BalanceXLine" Stroke="#55A7FF" StrokeThickness="1.5" />
                            <Polyline x:Name="BalanceYLine" Stroke="#FFB454" StrokeThickness="1.5" />
                            <Polyline x:Name="TemperatureLine" Stroke="#D889FF" StrokeThickness="1.5" />
                        </Canvas>
                    </Border>
                    <TextBlock Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="生値はADC相当のカウントです。荷重への換算は各センサーの0/17/34 kg工場校正点間を線形補間します。34 kgを超える領域は外挿のため精度保証外です。" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
