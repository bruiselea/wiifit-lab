<Window x:Class="WiiFitLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wii Fit Lab"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="640"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wii Fit Lab" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="バランスWiiボード・ライブモニター" Margin="1,3,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="14" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F0A84A" Margin="0,0,9,0" />
                    <TextBlock x:Name="StatusText" Text="接続準備中" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="合計荷重（温度補正後）" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="WeightText" Text="0.0" FontSize="62" FontWeight="Bold" />
                            <TextBlock Text="kg" FontSize="22" Margin="10,28,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="30" Padding="18">
                            <Canvas x:Name="BalanceCanvas" Width="330" Height="350" ClipToBounds="True">
                                <Rectangle Width="330" Height="350" RadiusX="22" RadiusY="22"
                                           Fill="#111A26" Stroke="#33445A" StrokeThickness="2" />
                                <Line X1="165" Y1="26" X2="165" Y2="324" Stroke="#29394C" StrokeThickness="1" />
                                <Line X1="26" Y1="175" X2="304" Y2="175" Stroke="#29394C" StrokeThickness="1" />
                                <Ellipse Width="112" Height="112" Canvas.Left="109" Canvas.Top="119"
                                         Stroke="#2C4156" StrokeThickness="1" />
                                <TextBlock Text="前" Canvas.Left="157" Canvas.Top="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="後" Canvas.Left="157" Canvas.Top="318" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="左" Canvas.Left="12" Canvas.Top="166" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="右" Canvas.Left="299" Canvas.Top="166" Foreground="{StaticResource MutedBrush}" />
                                <Ellipse x:Name="CenterDot" Width="24" Height="24" Canvas.Left="153" Canvas.Top="163"
                                         Fill="{StaticResource AccentBrush}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#48D7C8" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
                    <StackPanel>
                        <TextBlock Text="4つの荷重センサー" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="14">
                                <StackPanel><TextBlock Text="左前" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="TopLeftText" Text="0.0 kg" FontSize="22" /></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="14">
                                <StackPanel><TextBlock Text="右前" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="TopRightText" Text="0.0 kg" FontSize="22" /></StackPanel>
                            </Border>
                            <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="14">
                                <StackPanel><TextBlock Text="左後" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="BottomLeftText" Text="0.0 kg" FontSize="22" /></StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource PanelAltBrush}" CornerRadius="10" Padding="14">
                                <StackPanel><TextBlock Text="右後" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="BottomRightText" Text="0.0 kg" FontSize="22" /></StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="左右位置" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="BalanceXText" Text="50.0 %" FontSize="25" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="前後位置" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="BalanceYText" Text="50.0 %" FontSize="25" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
                    <StackPanel>
                        <TextBlock Text="ボード内部データ" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,12" Text="温度は未公開仕様のため参考値です" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="現在温度（参考）" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="TemperatureText" Text="—" FontSize="19" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="工場基準 / 差" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="ReferenceTemperatureText" Text="—" FontSize="19" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="電池" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="BatteryText" Text="—" FontSize="19" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="補正前重量" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="UncorrectedWeightText" Text="0.0 kg" FontSize="19" />
                            </StackPanel>
                            <Border Grid.Row="4" Grid.ColumnSpan="2" Background="{StaticResource PanelAltBrush}"
                                    CornerRadius="8" Padding="10,7">
                                <TextBlock x:Name="CorrectionText" Text="温度補正差  0.000 kg"
                                           Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ConnectButton" Content="接続する" Click="ConnectButton_Click" />
            <Button Grid.Column="2" x:Name="TareButton" Content="ゼロ調整" Style="{StaticResource SecondaryButton}"
                    Click="TareButton_Click" IsEnabled="False" />
            <Button Grid.Column="4" x:Name="RecordButton" Content="CSV記録を開始" Style="{StaticResource SecondaryButton}"
                    Click="RecordButton_Click" IsEnabled="False" />
            <Button Grid.Column="6" x:Name="DiagnosticsButton" Content="技術モニター" Style="{StaticResource SecondaryButton}"
                    Click="DiagnosticsButton_Click" />
            <Button Grid.Column="8" x:Name="PedalButton" Content="ペダルモード" Style="{StaticResource SecondaryButton}"
                    Click="PedalButton_Click" />
            <Button Grid.Column="10" x:Name="MiniGamesButton" Content="ミニゲーム" Style="{StaticResource SecondaryButton}"
                    Click="MiniGamesButton_Click" />
            <TextBlock Grid.Column="12" x:Name="RecordStatusText" Text="未記録" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
