<Window x:Class="WiiFitLab.HoverRaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wii Fit Lab — ネオン・ホバーサーキット"
        Width="1120" Height="760" MinWidth="1060" MinHeight="720"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="800" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#050716" CornerRadius="16" ClipToBounds="True"
                BorderBrush="#7E5CFF" BorderThickness="2">
            <Canvas x:Name="RaceCanvas" Width="800" Height="670" ClipToBounds="True">
                <Rectangle Width="800" Height="670" Fill="#050716" />
                <Canvas x:Name="StarLayer" />
                <Polygon Points="145,670 260,40 540,40 655,670" Fill="#12182D"
                         Stroke="#6B4DFF" StrokeThickness="4" />
                <Polygon Points="162,670 271,52 529,52 638,670" Fill="#171F39"
                         Stroke="#19E6FF" StrokeThickness="2" />
                <Canvas x:Name="LaneLayer" Panel.ZIndex="2" />
                <Canvas x:Name="ObjectLayer" Panel.ZIndex="5" />

                <Border x:Name="HoverCraft" Width="64" Height="92" Canvas.Left="368" Canvas.Top="545"
                        CornerRadius="26,26,12,12" Background="#FF3D8D" BorderBrush="#8DF7FF"
                        BorderThickness="2" Panel.ZIndex="10" RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Polygon Points="32,4 55,68 43,83 32,72 21,83 9,68" Fill="#FF3D8D" />
                        <Border Width="21" Height="42" Margin="0,12,0,26" Background="#492B82"
                                CornerRadius="10" BorderBrush="#C5EFFF" BorderThickness="1" />
                        <Rectangle Width="5" Height="63" Fill="#7EFAFF" />
                        <Ellipse Width="15" Height="15" Fill="#F7FEFF" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#19E6FF" BlurRadius="20" ShadowDepth="0" Opacity="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <Border.Effect>
                        <DropShadowEffect Color="#FF3D8D" BlurRadius="20" ShadowDepth="0" Opacity="0.9" />
                    </Border.Effect>
                </Border>

                <Border Canvas.Left="16" Canvas.Top="14" Background="#DB050716" CornerRadius="10"
                        Padding="13,7" Panel.ZIndex="20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SpeedText" Text="0" FontSize="32" FontWeight="Bold" />
                        <TextBlock Text=" km/h" Margin="4,13,16,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="DistanceText" Text="0.00 km" FontSize="17" Margin="0,9,15,0" />
                        <TextBlock Text="BEST " Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                        <TextBlock x:Name="BestSpeedText" Text="0" Margin="4,10,0,0" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Canvas.Left="575" Canvas.Top="15" Width="205" Background="#DB050716"
                        CornerRadius="10" Padding="12,8" Panel.ZIndex="20">
                    <StackPanel>
                        <TextBlock Text="MACHINE ENERGY" FontSize="10" Foreground="#8DF7FF" />
                        <ProgressBar x:Name="EnergyProgress" Minimum="0" Maximum="100" Value="100"
                                     Height="17" Foreground="#19E6FF" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="AlertBanner" Canvas.Left="260" Canvas.Top="300" Width="280"
                        Background="#E649236F" CornerRadius="12" Padding="18,10"
                        Visibility="Collapsed" Panel.ZIndex="25">
                    <TextBlock x:Name="AlertText" Text="BOOST!" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </Border>

                <Border x:Name="StartPanel" Canvas.Left="235" Canvas.Top="330" Width="330"
                        Background="#E80C1225" CornerRadius="14" Padding="20,15" Panel.ZIndex="30">
                    <StackPanel>
                        <TextBlock x:Name="StartTitle" Text="NEON HOVER CIRCUIT" FontSize="21"
                                   FontWeight="Bold" HorizontalAlignment="Center" Foreground="#8DF7FF" />
                        <TextBlock x:Name="StartMessage" Text="中心姿勢を記録してスタート"
                                   Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ネオン・ホバーサーキット" FontSize="23" FontWeight="Bold" />
                <TextBlock Text="近未来ハイスピード・タイムアタック" Foreground="{StaticResource MutedBrush}" />

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SignalStatusText" Text="ボード信号待ち" Foreground="#F0A84A" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="操舵" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <ProgressBar x:Name="SteeringProgress" Minimum="-100" Maximum="100" Height="17" />
                                <TextBlock x:Name="SteeringText" Text="0 %" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="加速 / ブレーキ" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="ThrottleText" Text="0 / 0 %" FontSize="18" />
                            </StackPanel>
                        </Grid>
                        <Button Content="現在の姿勢を中心にする" Click="CaptureCenter_Click" Margin="0,10,0,0" />
                        <TextBlock Text="操作感度" Margin="0,10,0,1" />
                        <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="3" Value="2"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="SensitivityText" Text="2.0倍" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="0,10,0,0">
                    <StackPanel>
                        <Button x:Name="StartButton" Content="レース開始" Click="StartButton_Click" IsEnabled="False" />
                        <Button Content="最初からやり直す" Click="ResetButton_Click"
                                Style="{StaticResource SecondaryButton}" Margin="0,7,0,0" />
                        <TextBlock x:Name="RaceStatusText" Text="中心姿勢を記録してください"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="15" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="操作" FontWeight="SemiBold" />
                        <TextBlock Text="前傾：加速　後傾：ブレーキ&#x0a;左右傾き：操舵　Aボタン：ブースト&#x0a;予備：WASD / 矢印、Space：ブースト"
                                   Foreground="{StaticResource MutedBrush}" LineHeight="20" Margin="0,5,0,0" />
                        <TextBlock Text="紫の障害物を避け、青いブースト床を狙います。コース外とブーストはエネルギーを消費します。"
                                   Foreground="#8DF7FF" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#3A2C1D" CornerRadius="10" Padding="11" Margin="0,10,0,0">
                    <TextBlock Text="安全：滑らない平らな場所で、壁や手すりに手が届く状態で小さく重心移動してください。"
                               Foreground="#FFD08A" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
