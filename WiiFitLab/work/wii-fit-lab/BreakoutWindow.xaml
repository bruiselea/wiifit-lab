<Window x:Class="WiiFitLab.BreakoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wii Fit Lab — バランス・ブロック崩し"
        Width="1110" Height="760" MinWidth="1040" MinHeight="720"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="800" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#101824" CornerRadius="16" ClipToBounds="True"
                BorderBrush="#2A3B50" BorderThickness="2">
            <Canvas x:Name="GameCanvas" Width="800" Height="670" ClipToBounds="True">
                <Rectangle Width="800" Height="670" Fill="#101824" />
                <Rectangle Width="800" Height="670" Fill="#101824">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.75" />
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Canvas x:Name="BrickLayer" Panel.ZIndex="2" />

                <Border x:Name="Paddle" Width="126" Height="18" Canvas.Left="337" Canvas.Top="620"
                        Background="#48D7C8" CornerRadius="9" Panel.ZIndex="5">
                    <Border.Effect>
                        <DropShadowEffect Color="#48D7C8" BlurRadius="14" ShadowDepth="0" Opacity="0.75" />
                    </Border.Effect>
                </Border>
                <Ellipse x:Name="Ball" Width="18" Height="18" Canvas.Left="391" Canvas.Top="598"
                         Fill="#F8FCFF" Panel.ZIndex="6">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FFFFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>

                <Border Canvas.Left="16" Canvas.Top="14" Background="#D90B111A" CornerRadius="10"
                        Padding="13,7" Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SCORE " Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ScoreText" Text="000000" FontWeight="Bold" FontSize="18" />
                        <TextBlock Text="　LIFE " Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="LivesText" Text="● ● ●" Foreground="#FF6B7A" FontSize="17" />
                        <TextBlock Text="　LEVEL " Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="LevelText" Text="1" FontWeight="Bold" FontSize="18" />
                    </StackPanel>
                </Border>

                <Border x:Name="MessagePanel" Canvas.Left="225" Canvas.Top="330" Width="350"
                        Background="#E8141D29" CornerRadius="14" Padding="20,14" Panel.ZIndex="20">
                    <StackPanel>
                        <TextBlock x:Name="MessageTitle" Text="準備OK" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="MessageText" Text="Aボタン または Space / Enter で発射"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Border>

        <StackPanel Grid.Column="2">
            <TextBlock Text="バランス・ブロック崩し" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="重心移動の反応を見るミニゲーム" Foreground="{StaticResource MutedBrush}" />

            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="SignalStatusText" Text="ボード信号待ち" Foreground="#F0A84A" />
                    <TextBlock Text="パドル位置" Margin="0,13,0,3" />
                    <ProgressBar x:Name="BalanceProgress" Minimum="0" Maximum="100" Value="50"
                                 Height="22" Foreground="#48D7C8" />
                    <TextBlock x:Name="BalanceText" Text="50.0 %（中央）"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="左右感度" Margin="0,13,0,3" />
                    <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="3" Value="3"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" />
                    <TextBlock x:Name="SensitivityText" Text="3.0倍（33.3〜66.7%で全幅）"
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="操作" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="ボード：左右へゆっくり重心移動&#x0a;発射：前面Aボタン&#x0a;予備：← → / A D、Space / Enter"
                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" LineHeight="22" />
                    <TextBlock Text="パドルの端で返すほど斜めに飛びます。"
                               Foreground="#48D7C8" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <Button Content="最初からやり直す" Click="ResetButton_Click" />
                    <Button x:Name="PauseButton" Content="一時停止" Click="PauseButton_Click"
                            Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" />
                    <TextBlock x:Name="GameStatusText" Text="発射待ち"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>
            </Border>

            <Border Background="#3A2C1D" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                <TextBlock Text="安全：滑らない平らな場所で、壁や手すりに手が届く状態で遊んでください。大きく傾く必要はありません。"
                           Foreground="#FFD08A" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
