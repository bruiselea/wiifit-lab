<Window x:Class="WiiFitLab.GameHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Wii Fit Lab — ミニゲーム"
        Width="1260" Height="820" MinWidth="1100" MinHeight="720"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Wii Fit Arcade" FontSize="32" FontWeight="Bold" />
                <TextBlock Text="バランスWiiボードで遊びながら入力をテスト"
                           Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="1,4,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14,8">
                <TextBlock x:Name="ConnectionText" Text="● ボード確認中" Foreground="#F0A84A" />
            </Border>
        </Grid>

        <primitives:UniformGrid Grid.Row="2" Rows="2" Columns="3">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="7">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="54" Height="54" CornerRadius="14" Background="#25364A" HorizontalAlignment="Left">
                        <TextBlock Text="🚗" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,11,0,12">
                        <TextBlock Text="ペダル・テストコース" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="左右の足をブレーキとアクセルにする簡易ドライブ。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="足元 + ← → / A D" Foreground="#48D7C8" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2" Content="ドライブを開く" Click="DriveButton_Click" />
                </Grid>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="7"
                    BorderBrush="#48D7C8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="54" Height="54" CornerRadius="14" Background="#173E3B" HorizontalAlignment="Left">
                        <TextBlock Text="▦" FontSize="31" Foreground="#48D7C8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,11,0,12">
                        <TextBlock Text="バランス・ブロック崩し" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="左右の重心移動でパドルと反射角をコントロール。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="重心左右 / ← →　Aで発射" Foreground="#48D7C8" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2" Content="ブロック崩しを開く" Click="BreakoutButton_Click" />
                </Grid>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="7"
                    BorderBrush="#8C48FF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="54" Height="54" CornerRadius="14" Background="#2B2148" HorizontalAlignment="Left">
                        <TextBlock Text="◆" FontSize="31" Foreground="#19E6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,11,0,12">
                        <TextBlock Text="ネオン・ホバーサーキット" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="全身の重心で操る近未来ハイスピードレース。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="前後左右の重心 / WASD　Aでブースト" Foreground="#19E6FF" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2" Content="ホバーレースを開く" Click="HoverRaceButton_Click" />
                </Grid>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="7"
                    BorderBrush="#FFD166" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="54" Height="54" CornerRadius="14" Background="#40371E">
                            <TextBlock Text="●" FontSize="34" Foreground="#D7F5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#FFD166" CornerRadius="8" Padding="7,2" Margin="10,3,0,0" VerticalAlignment="Top">
                            <TextBlock Text="NEW" Foreground="#251B08" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,11,0,12">
                        <TextBlock Text="3Dバランス・テーブル" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="浮遊する立体盤面を傾け、複数の球を穴へ入れる全5レベル。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="前後左右の重心 / 矢印・WASD" Foreground="#FFD166" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2" Content="3Dテーブルを開く" Click="TiltMazeButton_Click" />
                </Grid>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18" Margin="7"
                    BorderBrush="#8DE8FF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="54" Height="54" CornerRadius="14" Background="#17314A">
                            <TextBlock Text="▲" FontSize="30" Foreground="#F3FBFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#8DE8FF" CornerRadius="8" Padding="7,2" Margin="10,3,0,0" VerticalAlignment="Top">
                            <TextBlock Text="NEW" Foreground="#071522" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,11,0,12">
                        <TextBlock Text="サイドスタンス・スノー" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="ボードを90°回し、前後の足とエッジ荷重で雪山を滑走。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="横置き重心 / 矢印・WASD" Foreground="#8DE8FF" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2" Content="スノーボードを開く" Click="SnowboardButton_Click" />
                </Grid>
            </Border>
        </primitives:UniformGrid>

        <TextBlock Grid.Row="4" Text="ミニゲームは今後もここへ追加していきます"
                   HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
    </Grid>
</Window>
