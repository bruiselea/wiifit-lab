<Window x:Class="WiiFitLab.DriveSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wii Fit Lab — ドライブシミュ"
        Width="1120" Height="760" MinWidth="980" MinHeight="700"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Yu Gothic UI" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="720" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#183D27" CornerRadius="15" ClipToBounds="True">
            <Canvas x:Name="RoadCanvas" Width="720" Height="670" ClipToBounds="True">
                <Rectangle Width="720" Height="670" Fill="#1D5633" />
                <Rectangle Width="520" Height="670" Canvas.Left="100" Fill="#303642" />
                <Rectangle Width="7" Height="670" Canvas.Left="100" Fill="#F2F5F7" />
                <Rectangle Width="7" Height="670" Canvas.Left="613" Fill="#F2F5F7" />
                <Rectangle Width="18" Height="670" Canvas.Left="107" Fill="#D84B52" Opacity="0.45" />
                <Rectangle Width="18" Height="670" Canvas.Left="595" Fill="#D84B52" Opacity="0.45" />
                <Canvas x:Name="LaneMarksLayer" Panel.ZIndex="2" />

                <Border x:Name="CarSprite" Width="54" Height="96" Canvas.Left="333" Canvas.Top="515"
                        Background="#FF4E5E" CornerRadius="12" BorderBrush="#FFD1D5" BorderThickness="2"
                        Panel.ZIndex="10" RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Border Margin="8,14,8,48" Background="#A9D8F2" CornerRadius="5" />
                        <Border Margin="9,57,9,13" Background="#172330" CornerRadius="5" />
                        <Rectangle Width="4" Height="74" Fill="#FFCF55" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Canvas.Left="18" Canvas.Top="18" Background="#C90B111A" CornerRadius="10" Padding="14,8"
                        Panel.ZIndex="20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SpeedText" Text="0" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text=" km/h" FontSize="15" Margin="5,15,18,0" />
                        <TextBlock x:Name="DistanceText" Text="0.00 km" FontSize="18" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="OffRoadBanner" Canvas.Left="256" Canvas.Top="20" Background="#D9C73542"
                        CornerRadius="9" Padding="15,8" Visibility="Collapsed" Panel.ZIndex="20">
                    <TextBlock Text="路肩！速度が落ちます" FontWeight="Bold" />
                </Border>
                <Border Canvas.Left="18" Canvas.Top="611" Background="#C90B111A" CornerRadius="9" Padding="12,7"
                        Panel.ZIndex="20">
                    <TextBlock Text="操舵  ← → または A / D　　R：車を戻す" />
                </Border>
            </Canvas>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ペダル・テストコース" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="外部ゲーム入力なしで踏力を試せます" Foreground="{StaticResource MutedBrush}" />

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SignalStatusText" Text="信号待ち" Foreground="#F0A84A" />
                        <TextBlock Text="左足・ブレーキ" Margin="0,12,0,3" />
                        <ProgressBar x:Name="BrakeProgress" Maximum="100" Height="22" Foreground="#FF6B7A" />
                        <TextBlock x:Name="BrakeText" Text="0 %  /  0.0 kg" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="右足・アクセル" Margin="0,10,0,3" />
                        <ProgressBar x:Name="AcceleratorProgress" Maximum="100" Height="22" Foreground="#48D7C8" />
                        <TextBlock x:Name="AcceleratorText" Text="0 %  /  0.0 kg" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ペダル校正" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="両足を置いて基準、左右を別々に強く踏んで最大を記録します。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <Button Content="1  基準を記録" Click="CaptureRest_Click" Margin="0,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="2  左最大" Click="CaptureBrakeMax_Click" Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="2" Content="3  右最大" Click="CaptureAcceleratorMax_Click" Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <TextBlock x:Name="CalibrationText" Text="基準 — / — kg&#x0a;最大 — / — kg"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <Button x:Name="StartButton" Content="走行開始" Click="StartButton_Click" IsEnabled="False" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="車を戻す" Click="ResetCar_Click" Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="2" Content="校正リセット" Click="ResetCalibration_Click" Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <TextBlock x:Name="DriveStatusText" Text="ペダルを校正してください"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,13,2,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="椅子に座り、ボードが滑らない状態で使用してください。ウィンドウが非アクティブになると操舵キーは解除され、信号が250ms途切れると走行を一時停止します。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
